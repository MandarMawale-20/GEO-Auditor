# GEO Auditor environment configuration
# Copy this file to .env and fill in values as needed.
# The app runs perfectly with NO values set — Gemini is entirely optional.

# Optional: Google Gemini API key. If unset, all semantic checks (Query
# Coverage, AI Citation Snippet Quality) automatically use deterministic
# heuristic fallbacks instead of calling the Gemini API.
GEMINI_API_KEY=

# Gemini model name (default shown).
GEMINI_MODEL=gemini-1.5-flash

# Gemini REST base URL (default shown, rarely needs changing).
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# HTTP timeout (seconds) for fetching the target site, robots.txt, sitemap.xml.
REQUEST_TIMEOUT_SECONDS=8.0

# Timeout (seconds) for each Gemini API call.
LLM_TIMEOUT_SECONDS=6.0

# Safety cap on how many bytes of HTML are processed per audit.
MAX_HTML_BYTES=3000000

# development | production — currently used only for informational display.
APP_ENV=development
