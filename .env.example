GROQ_API_KEY=Your_GROQ_API_Key_Here

GROQ_MODEL=llama-3.1-8b-instant

GROQ_BASE_URL=https://api.groq.com/openai/v1

REQUEST_TIMEOUT_SECONDS=8.0

LLM_TIMEOUT_SECONDS=6.0

MAX_HTML_BYTES=3000000

APP_ENV=development

# Multipage crawling (single-page audit remains the API default unless
# `pages=2..10` is explicitly requested).
CRAWL_ENABLED=true
CRAWL_MAX_PAGES=10
CRAWL_CONCURRENCY=3
CRAWL_TOTAL_BUDGET_SECONDS=15.0
CRAWL_PAGE_TIMEOUT_SECONDS=8.0
CRAWL_MAX_DISCOVERED_LINKS=200
CRAWL_INCLUDE_SUBDOMAINS=false
CRAWL_LLM_MAX_PAGES=2

# Homepage weight in coverage checks (internal pages are 1x).
HOMEPAGE_WEIGHT=2.0
